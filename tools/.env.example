# Jira + Confluence Tool — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── JIRA ──────────────────────────────────────────────────────────────────────

# Base URL of your Jira instance (no trailing slash, no /secure/Dashboard.jspa)
# Example: https://nhsd-jira.digital.nhs.uk
JIRA_BASE_URL=https://nhsd-jira.digital.nhs.uk

# Personal Access Token
# Generate in Jira: Profile → Personal Access Tokens → Create token
# Required permissions: Browse Projects, Add Comments
JIRA_PAT=your_jira_personal_access_token_here

# ── CONFLUENCE ────────────────────────────────────────────────────────────────

# Base URL of your Confluence instance (no trailing slash)
# Example: https://nhsd-confluence.digital.nhs.uk
CONFLUENCE_BASE_URL=https://nhsd-confluence.digital.nhs.uk

# Personal Access Token for Confluence
# Generate in Confluence: Profile → Personal Access Tokens → Create token
# Required permissions: View Space, Edit Pages
# Note: Jira and Confluence PATs are separate even if hosted by the same organisation
CONFLUENCE_PAT=your_confluence_personal_access_token_here
